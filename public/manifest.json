{
  "name": "TravelTrack",
  "short_name": "TravelTrack",
  "description": "Planejamento e orçamento de viagens em grupo",
  "start_url": "/trips",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova Despesa",
      "short_name": "Despesa",
      "description": "Registrar uma nova despesa na viagem",
      "url": "/share",
      "icons": [{ "src": "/shortcut-despesa.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Roteiro",
      "short_name": "Roteiro",
      "description": "Ver o roteiro da viagem ativa",
      "url": "/roteiro",
      "icons": [{ "src": "/shortcut-roteiro.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "text": "text",
      "title": "title",
      "url": "url"
    }
  }
}
